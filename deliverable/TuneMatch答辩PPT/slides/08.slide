<Slide style={{ width: 1280, height: 720, background: '#ffffff', padding: '20px 64px' }}>
  {/* A 标题块 */}
  <Box style={{ height: 100, justifyContent: 'center' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1D1D1F' }}>创新点 · Innovations</Text>
  </Box>
  {/* B 内容区：4 大创新卡 */}
  <Box style={{ flex: 1, flexDirection: 'row', gap: 22, justifyContent: 'center' }}>
    {[
      { n: '01', t: '透明可解释推荐', d: '每条推荐附带 70-98% 匹配度与特征解释，列表页保证非 0%，用户可理解推荐逻辑', c: '#0071E3', i: 'magnifying-glass-chart' },
      { n: '02', t: '画像驱动社交预演', d: '每首歌 11 维特征 + 每歌单曲风画像，为「相似品味匹配」社交功能预留数据管道', c: '#7C3AED', i: 'user-group' },
      { n: '03', t: '零成本三源曲库', d: 'iTunes Search + Apple RSS 热门榜 + Jamendo，无需商业 Key 即获 777 首真实可听曲目', c: '#FF6B9D', i: 'database' },
      { n: '04', t: '歌单导入即画像', d: '粘贴任意歌单文本 → 自动匹配、曲风画像、生成专辑级 SVG 创意封面，形成导入-分析-可视化闭环', c: '#10B981', i: 'wand-magic-sparkles' },
    ].map((f) => (
      <Box key={f.n} style={{ flex: 1, background: '#F5F5F7', borderRadius: 20, padding: 26, gap: 14, justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
          <Text style={{ fontSize: 36, fontWeight: 'bold', color: f.c }}>{f.n}</Text>
          <FAIcon name={f.i} style={{ fill: f.c, width: 34, height: 34 }} />
        </Box>
        <Box style={{ gap: 8 }}>
          <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#1D1D1F' }}>{f.t}</Text>
          <Text style={{ fontSize: 16, color: '#6E6E73', lineHeight: 1.7 }}>{f.d}</Text>
        </Box>
        <Box style={{ width: 44, height: 5, background: f.c, borderRadius: 3 }} />
      </Box>
    ))}
  </Box>
  {/* C 页脚 */}
  <Box style={{ height: 50, flexDirection: 'row', alignItems: 'center', justifyContent: 'flex-end' }}>
    <Text style={{ fontSize: 14, color: '#86868B' }}>08 / 12</Text>
  </Box>
</Slide>
