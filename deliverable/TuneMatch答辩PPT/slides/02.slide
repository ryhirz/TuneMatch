<Slide style={{ width: 1280, height: 720, background: '#ffffff', padding: '20px 64px' }}>
  {/* A 标题块 */}
  <Box style={{ height: 100, justifyContent: 'center' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1D1D1F' }}>目录 · CONTENTS</Text>
  </Box>
  {/* B 内容区：4 章列表 */}
  <Box style={{ flex: 1, flexDirection: 'row', gap: 32, alignItems: 'center', justifyContent: 'center' }}>
    <Box style={{ flex: 1, gap: 22 }}>
      {[
        { n: '01', t: '项目背景', d: '传统推荐冷启动 · 透明可解释', c: '#0071E3' },
        { n: '02', t: '功能设计', d: '12 个功能模块 · 多模态输入', c: '#7C3AED' },
        { n: '03', t: '技术架构', d: 'Vue3 + FastAPI + 多源数据', c: '#FF6B9D' },
        { n: '04', t: '数据与成果', d: '777 首曲库 · 49 项测试全通过', c: '#10B981' },
      ].map((s) => (
        <Box key={s.n} style={{ flexDirection: 'row', alignItems: 'center', gap: 24, background: '#F5F5F7', borderRadius: 16, padding: '22px 28px' }}>
          <Text style={{ fontSize: 40, fontWeight: 'bold', color: s.c, width: 90 }}>{s.n}</Text>
          <Box style={{ gap: 2 }}>
            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1D1D1F' }}>{s.t}</Text>
            <Text style={{ fontSize: 17, color: '#6E6E73' }}>{s.d}</Text>
          </Box>
        </Box>
      ))}
    </Box>
    <Box style={{ width: 340, alignItems: 'center', gap: 12 }}>
      <Box style={{ width: 260, height: 260, borderRadius: 24, background: 'linear-gradient(135deg, #0071E3, #7C3AED)', alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 110, color: '#ffffff' }}>♪</Text>
      </Box>
      <Text style={{ fontSize: 18, color: '#6E6E73', textAlign: 'center', lineHeight: 1.6 }}>AI 智能音乐推荐平台\n让每一次听歌都被理解</Text>
    </Box>
  </Box>
  {/* C 页脚 */}
  <Box style={{ height: 50, flexDirection: 'row', alignItems: 'center', justifyContent: 'flex-end' }}>
    <Text style={{ fontSize: 14, color: '#86868B' }}>02 / 12</Text>
  </Box>
</Slide>
